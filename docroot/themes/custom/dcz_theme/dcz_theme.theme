<?php

/**
 * @file
 * Drupal CZ theme file.
 */

use Drupal\views\Views;

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 *
 * Adding template suggestion for page based on content type.
 */
function dcz_theme_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Add content type suggestions.
  $node = \Drupal::request()->attributes->get('node');
  if (!empty($node) && is_object($node)) {
    array_splice($suggestions, 1, 0, 'page__node__' . $node->getType());
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 *
 * Nodes displayed through a core field_layout use a minimal wrapper template.
 */
function dcz_theme_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  // Bundle => view modes that were rendered by Panelizer and now use layouts.
  $layout_displays = [
    'dcz_article' => ['search_index', 'teaser', 'title_date'],
    'dcz_landing_page' => ['full', 'search_index', 'teaser'],
    'dcz_showcase' => ['stack', 'teaser'],
    'forum' => ['title_date'],
    'page' => ['search_index', 'teaser'],
    'tutorial' => ['search_index', 'teaser', 'title_date'],
  ];
  $node = $variables['elements']['#node'] ?? NULL;
  $view_mode = $variables['elements']['#view_mode'] ?? '';
  if ($node && in_array($view_mode, $layout_displays[$node->bundle()] ?? [], TRUE)) {
    $suggestions[] = 'node__field_layout';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function dcz_theme_theme_suggestions_user_alter(array &$suggestions, array $variables) {
  $view_mode = $variables["elements"]["#view_mode"];
  $suggestions[] = 'user__' . $view_mode;
  // The profile page (laid out with field_layout) has its own wrapper markup.
  if (in_array($view_mode, ['default', 'full'], TRUE)) {
    $suggestions[] = 'user__field_layout';
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function dcz_theme_preprocess_user(&$variables) {
  /** @var \Drupal\user\Entity\User $user */
  $user = $variables['user'];
  $title_parts = [];
  if (!empty($user->field_dcz_name->value)) {
    $title_parts[] = $user->field_dcz_name->value;
  }
  if (!empty($user->field_dcz_surname->value)) {
    $title_parts[] = $user->field_dcz_surname->value;
  }
  if (!empty($title_parts)) {
    $title = $user->toLink(implode(" ", $title_parts));
  }
  else {
    $title = $user->toLink();
  }
  $variables['user_title'] = $title->toRenderable();

  // The full user profile lists the user's articles and tutorials below the
  // profile fields. Views blocks cannot be field_layout components, so they are
  // added to the layout regions here.
  if (in_array($variables['elements']['#view_mode'] ?? '', ['default', 'full'], TRUE) && isset($variables['content']['_field_layout'])) {
    $lists = [
      'first_below' => ['dcz_articles', 'block_user_articles'],
      'second_below' => ['dcz_tutorials', 'block_user_tutorials'],
    ];
    foreach ($lists as $region => [$view_id, $display_id]) {
      $view = Views::getView($view_id);
      if (!$view || !$view->access($display_id)) {
        continue;
      }
      $view->setDisplay($display_id);
      // Show only the first page of items, without a pager, as the blocks did.
      $pager = $view->display_handler->getOption('pager');
      $view->display_handler->setOption('pager', [
        'type' => 'some',
        'options' => [
          'items_per_page' => $pager['options']['items_per_page'] ?? 10,
          'offset' => 0,
        ],
      ]);
      $variables['content']['_field_layout'][$region]['user_' . $view_id] = [
        '#theme' => 'block',
        '#configuration' => [
          'label' => $view->getTitle(),
          'label_display' => 'visible',
          'provider' => 'views',
        ],
        '#plugin_id' => 'views_block:' . $view_id . '-' . $display_id,
        '#base_plugin_id' => 'views_block',
        '#derivative_plugin_id' => $view_id . '-' . $display_id,
        '#weight' => 0,
        'content' => $view->buildRenderable($display_id, [$user->id()]),
      ];
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * Node title, author and created date are display-configurable (see the
 * dcz_base_fields module) and hidden in most displays. Core's node preprocess
 * still expects them to be rendered, so provide them for the submitted info
 * and teaser label.
 */
function dcz_theme_preprocess_node(&$variables) {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  $view = function (string $field) use ($node) {
    $options = $node->getFieldDefinition($field)->getDisplayOptions('view');
    return $node->get($field)->view($options);
  };
  if (empty($variables['date']) && isset($variables['date'])) {
    $variables['date'] = \Drupal::service('renderer')->render($view('created'));
  }
  if (empty($variables['author_name']) && isset($variables['author_name'])) {
    $variables['author_name'] = \Drupal::service('renderer')->render($view('uid'));
  }
  if (!isset($variables['label'])) {
    $variables['label'] = $view('title');
  }
}

/**
 * Implements hook_preprocess_HOOK() for page title blocks.
 *
 * The user profile shows the user name through its own display, so the page
 * title block stays empty there.
 */
function dcz_theme_preprocess_page_title(&$variables) {
  if (\Drupal::routeMatch()->getRouteName() === 'entity.user.canonical') {
    $variables['title'] = '';
  }
}
