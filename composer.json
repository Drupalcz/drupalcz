{
    "name": "drupalcz/site",
    "description": "Drupal.cz Community website. (Drupal8 site built with BLT.)",
    "type": "project",
    "license": "GPL-2.0+",
    "authors": [
        {
            "name": "Czech Drupal Association z. s.",
            "role": "NGO overseeing the project"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "acquia/memcache-settings": "*",
        "bower-asset/flexslider": "^2.6",
        "composer/installers": "^2.2",
        "cweagans/composer-patches": "^1.6",
        "drupal/acquia_connector": "^4.1",
        "drupal/acquia_purge": "^1.0",
        "drupal/admin_toolbar": "^3.4",
        "drupal/better_normalizers": "^2.0@beta",
        "drupal/captcha": "^2.0",
        "drupal/ckeditor": "^1.0",
        "drupal/classy": "^2.0",
        "drupal/coder": "^8.3",
        "drupal/color": "^1.0",
        "drupal/config_filter": "^1.13",
        "drupal/config_split": "^2.0",
        "drupal/config_update": "^2.0@alpha",
        "drupal/core-composer-scaffold": "^10.6.20",
        "drupal/core-project-message": "^10.6.20",
        "drupal/core-recommended": "^10.6.20",
        "drupal/ctools": "^3.0",
        "drupal/default_content_deploy": "^2.0",
        "drupal/devel": "^5",
        "drupal/diff": "^2.1",
        "drupal/dropzonejs": "^2.0",
        "drupal/embed": "^1.0",
        "drupal/entity_browser": "^2.0",
        "drupal/entity_class_formatter": "^2.0",
        "drupal/entity_embed": "^1.4",
        "drupal/eu_cookie_compliance": "^1.0",
        "drupal/extlink": "^2.0",
        "drupal/flexslider": "^3.0",
        "drupal/forum": "^1.0.6",
        "drupal/geolocation": "^3.11",
        "drupal/geshifilter": "^3.0",
        "drupal/gin": "^4.1",
        "drupal/gin_toolbar": "^2.1",
        "drupal/google_analytics": "^4.0",
        "drupal/inline_entity_form": "^3.0",
        "drupal/jquery_ui": "^1.8",
        "drupal/jquery_ui_autocomplete": "^2.0",
        "drupal/jquery_ui_draggable": "^2.1",
        "drupal/jquery_ui_droppable": "^2.1",
        "drupal/jquery_ui_menu": "^2.1",
        "drupal/metatag": "^2.1",
        "drupal/panelizer": "^4.1",
        "drupal/panels": "^4.7",
        "drupal/panels_ipe": "^4.3",
        "drupal/paragraphs": "^1.5",
        "drupal/pathauto": "^1.6.0",
        "drupal/purge": "^3.0",
        "drupal/redirect": "^1.0",
        "drupal/riddler": "^3.0",
        "drupal/seckit": "^2.0",
        "drupal/security_review": "^3.1",
        "drupal/seven": "^1.0",
        "drupal/shield": "^1.9",
        "drupal/stage_file_proxy": "^3.1",
        "drupal/token": "^1.5",
        "drupal/upgrade_status": "^4.3",
        "drupal/viewsreference": "^2.0",
        "drupal/youtube": "^3.0@beta",
        "drush/drush": "^13.0",
        "enyo/dropzone": "^6.3",
        "oomphinc/composer-installers-extender": "^2.0",
        "pear/versioncontrol_git": "^0.5.0"
    },
    "replace": {
        "bower-asset/jquery": "*",
        "bower-asset/jqueryui": "*",
        "bower-asset/backbone": "*",
        "bower-asset/underscore": "*",
        "npm-asset/jquery": "*",
        "npm-asset/jqueryui": "*",
        "npm-asset/backbone": "*",
        "npm-asset/underscore": "*"
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 0,
        "platform": {
            "php": "8.4"
        },
        "audit": {
            "ignore": {
                "SA-CONTRIB-2025-036": "Panelizer is obsolete and every release is affected; it is being replaced separately.",
                "PKSA-ns3q-qtk3-d35r": "geshi/geshi comes with geshifilter, which is uninstalled in the next release and removed after that."
            }
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "grasmash/drupal-security-warning": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true
        }
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "asset-packagist": {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "docroot/"
            },
            "file-mapping": {
                "[web-root]/sites/development.services.yml": false,
                "[web-root]/sites/default/default.services.yml": false,
                "[web-root]/sites/default/default.settings.php": false
            }
        },
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/acquia_connector": {
                "3560014 - Fix PHP 8.4 deprecations: explicit nullable type must be used (MR !77 at 4c6f1381)": "patches/acquia_connector-3560014-mr77.patch"
            },
            "drupal/acquia_purge": {
                "PHP 8.4 nullable fix from 8.x-1.x commit 46f1bb17 (#3529087)": "patches/acquia_purge-46f1bb17-php84-nullable.patch"
            },
            "drupal/ckeditor": {
                "3622386 - Implicitly marking parameter as nullable is deprecated (MR !24 at 8a4f3c86)": "patches/ckeditor-3622386-mr24.patch"
            },
            "drupal/color": {
                "3533903 - PHP 8.4 - Implicitly nullable via default value null deprecation": "https://www.drupal.org/files/issues/2025-07-03/ot-php8.4-fix-implicit-nullable-deprecation.patch"
            },
            "drupal/ctools": {
                "PHP 8.4: make implicitly nullable parameters explicit": "patches/ctools-php84-explicit-nullable.patch"
            },
            "drupal/google_analytics": {
                "3562288 - PHP 8.4 - Implicit Nullable Parameters for Google Analytics (MR !45 at 8fe75cb8)": "patches/google_analytics-3562288-mr45.patch"
            },
            "drupal/panelizer": {
                "PHP 8.4: make implicitly nullable parameters explicit": "patches/panelizer-php84-explicit-nullable.patch"
            },
            "drupal/panels": {
                "PHP 8.4: make implicitly nullable parameters explicit": "patches/panels-php84-explicit-nullable.patch"
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "docroot/core": [
                "type:drupal-core"
            ],
            "docroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "docroot/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "docroot/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "docroot/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "docroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "docroot/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "docroot/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "drush/Commands/{$name}": [
                "type:drupal-drush"
            ]
        },
        "composer-exit-on-patch-failure": true
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\PHPUnit\\": "tests/phpunit/src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "sh scripts/build-libraries.sh"
        ],
        "post-update-cmd": [
            "sh scripts/build-libraries.sh"
        ],
        "nuke": [
            "rm -rf vendor composer.lock docroot/core docroot/modules/contrib docroot/profiles/contrib docroot/themes/contrib",
            "@composer clearcache --ansi",
            "@composer install --ansi"
        ],
        "init-theme": "sh scripts/init-theme.sh"
    }
}
